<div class="mb-4 d-flex justify-content-between align-items-center">
  <h1 class="h2 fw-bold text-dark mb-0">
    <%= @category.category_name %>
  </h1>
  <%= link_to root_path, class: "btn btn-outline-secondary rounded-pill px-4" do %>
    <i class="fa fa-arrow-left me-1"></i> Back to Home
  <% end %>
</div>

<% @category.subcategories.each do |subcategory| %>
  <% next if subcategory.products.empty? %>
  <section class="category-section mb-5">
    <div class="category-header">
      <h3 class="fw-bold mb-0 text-dark">
        <%= subcategory.subcategory_name %>
      </h3>
    </div>

    <div class="scroll-container">
      <% subcategory.products.each do |product| %>
        <div class="scroll-item">
          <div class="card product-card shadow-sm h-100 border-0">
            <div class="card-body d-flex flex-column p-4">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <h5 class="card-title h5 mb-0 text-truncate" style="max-width: 150px;"><%= product.p_name %></h5>
                <span class="price-tag">$<%= product.p_price %></span>
              </div>

              <div class="mb-3">
                <span class="category-badge"><%= @category.category_name %></span>
                <span class="ms-1 text-muted small">• <%= subcategory.subcategory_name %></span>
              </div>

              <p class="text-muted small mb-4">
                Availability: <span class="fw-bold <%= product.p_qty > 0 ? 'text-success' : 'text-danger' %>">
                  <%= product.p_qty > 0 ? "#{product.p_qty} in stock" : "Out of stock" %>
                </span>
              </p>

              <div class="mt-auto">
                <% if user_signed_in? %>
                  <% if current_user.owner? %>
                    <%= link_to product, class: "btn btn-outline-success w-100 rounded-pill" do %>
                      <i class="fa fa-eye me-1"></i> Manage
                    <% end %>
                  <% else %>
                    <% if product.p_qty > 0 %>
                      <div class="d-flex gap-2">
                        <%= button_to cart_items_path(product_id: product.id, action_key: 'buy'), method: :post, class: "btn btn-buy flex-grow-1" do %>
                          Buy Now
                        <% end %>
                        <%= button_to cart_items_path(product_id: product.id), method: :post, class: "btn btn-outline-primary rounded-pill px-3" do %>
                          <i class="fa fa-cart-plus"></i>
                        <% end %>
                      </div>
                    <% else %>
                      <span class="text-muted">Currently unavailable</span> 
                    <% end %>
                  <% end %>
                <% else %>
                  <%= link_to new_user_session_path, class: "btn btn-buy w-100" do %>
                    Sign in to Buy
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </section>
<% end %>

<% if @category.subcategories.empty? || @category.subcategories.all? { |s| s.products.empty? } %>
  <div class="text-center py-5">
    <div class="bg-white rounded-3 p-5 shadow-sm">
      <i class="fa fa-shopping-basket fa-4x text-muted mb-3"></i>
      <h3 class="text-muted">No products available in this category</h3>
      <p>Check back later or explore other categories.</p>
      <%= link_to "Explore All Products", root_path, class: "btn btn-success rounded-pill px-4 mt-2" %>
    </div>
  </div>
<% end %>