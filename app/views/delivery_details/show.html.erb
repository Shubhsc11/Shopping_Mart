<!-- <center><h2>Your Order Details</h2></center> -->

<div class="container" style="padding: 50px; background-color: #e8c06f; border-radius: 15px;">
  <h1 style="text-decoration-line: underline; text-align: center;">Your Details</h1>
  <br>  

  <h3>Full Name => <%= @delivery_detail.full_name %></h3>

  <h3>Address => <%= @delivery_detail.address %></h3>

  <h3>Contact No. => <%= @delivery_detail.contact_no %></h3>
  <br>

  <div class="row">
    <div class="col-sm-6" style="text-align: center;">
      <%= link_to "Edit Details", edit_delivery_detail_path(@delivery_detail), class: "btn btn-sm btn-outline-primary" %>
    </div>

	  <div class="col-sm-6" style="text-align: center;">
	    <%= button_to "Place Order", { controller: :orders, action: :update, id: @current_order.id, delivery_detail_id: @delivery_detail.id }, method: :put, class: "btn btn-sm btn-success" %>
	  </div>
	</div>
  <span>
    <i class="fa fa-credit-card-alt" aria-hidden="true"></i>
    Billing Points: <span style="color: black; background-color: white; border-radius: 5px; padding: 2px; font-weight: bold;">$<%= @current_order.sub_total %></span>  
  </span>
  <br>
  <span >
    <i class="fa fa-money" aria-hidden="true"></i>
    Remaining Points: <span style="color: black; background-color: white; border-radius: 5px; padding: 2px; font-weight: bold;">$<%= @available_points %></span>
  </span>
  <br>
</div>

