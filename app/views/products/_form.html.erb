<div class="light-theme-wrapper py-3">
  <div class="container d-flex justify-content-center">
    <div class="celestial-card shadow-xl overflow-hidden">
      <!-- Ambient Background Decoration -->
      <div class="mesh-gradient-1"></div>
      <div class="mesh-gradient-2"></div>

      <div class="card-content position-relative p-4 p-md-5">
        <div class="text-center mb-5">
          <div class="icon-box-neon mb-3 mx-auto">
            <i class="fa fa-briefcase text-cyan neon-text"></i>
          </div>
          <h2 class="fw-black text-slate-800 mb-1 tracking-tight">
            <%= (product.new_record? ? 'Add' : 'Update') + ' Inventory' %>
          </h2>
          <div class="horizontal-rule-gradient mx-auto"></div>
        </div>

        <%= form_with model: product, data: { controller: "dynamic-select", dynamic_select_url_value: subcategories_path } do |form| %>
          <div class="row g-4">
            <!-- Product Identity -->
            <div class="col-12">
              <div class="floating-input-group">
                <%= form.label :p_name, "Product Identity", class: "celestial-label" %>
                <div class="celestial-field-wrapper">
                  <i class="fa fa-fingerprint field-icon"></i>
                  <%= form.text_field :p_name, class: "celestial-input", placeholder: "Unique product name..." %>
                </div>
                <% @product.errors.full_messages_for(:p_name).each do |message| %>
                  <div class="celestial-error mt-2"><%= message %></div>
                <% end %>
              </div>
            </div>

            <!-- Price & Quantity -->
            <div class="col-md-6">
              <div class="floating-input-group">
                <%= form.label :p_price, "Unit Valuation ($)", class: "celestial-label" %>
                <div class="celestial-field-wrapper">
                  <i class="fa fa-coins field-icon"></i>
                  <%= form.number_field :p_price, class: "celestial-input", placeholder: "0.00" %>
                </div>
                <% @product.errors.full_messages_for(:p_price).each do |message| %>
                  <div class="celestial-error mt-2"><%= message %></div>
                <% end %>
              </div>
            </div>

            <div class="col-md-6">
              <div class="floating-input-group">
                <%= form.label :p_qty, "Available Stock", class: "celestial-label" %>
                <div class="celestial-field-wrapper">
                  <i class="fa fa-box-open field-icon"></i>
                  <%= form.number_field :p_qty, class: "celestial-input", placeholder: "0" %>
                </div>
                <% @product.errors.full_messages_for(:p_qty).each do |message| %>
                  <div class="celestial-error mt-2"><%= message %></div>
                <% end %>
              </div>
            </div>

            <!-- Categorization -->
            <div class="col-md-6">
              <div class="floating-input-group">
                <%= form.label :category_id, "Major Category", class: "celestial-label" %>
                <div class="celestial-field-wrapper">
                  <i class="fa fa-shapes field-icon"></i>
                  <%= form.select :category_id, Category.all.map { |a| [a.category_name, a.id] }, { prompt: "Choose Sector" }, 
                      { class: "celestial-select", data: { action: "change->dynamic-select#change" } } %>
                </div>
                <% @product.errors.full_messages_for(:category_id).each do |message| %>
                  <div class="celestial-error mt-2"><%= message %></div>
                <% end %>
              </div>
            </div>

            <div class="col-md-6">
              <div class="floating-input-group">
                <%= form.label :subcategory_id, "Specialization", class: "celestial-label" %>
                <div class="celestial-field-wrapper">
                  <i class="fa fa-microchip field-icon"></i>
                  <%= form.select :subcategory_id, 
                      (form.object.category ? form.object.category.subcategories.map { |s| [s.subcategory_name, s.id] } : []), 
                      { prompt: "Define Niche" }, 
                      { class: "celestial-select", data: { dynamic_select_target: "dynamicSelect" } } %>
                </div>
                <% @product.errors.full_messages_for(:subcategory_id).each do |message| %>
                  <div class="celestial-error mt-2"><%= message %></div>
                <% end %>
              </div>
            </div>

            <!-- Action -->
            <div class="col-12 mt-5">
              <button type="submit" class="btn-celestial-submit">
                <span class="btn-text">
                  <i class="fa fa-arrow-right-long me-2"></i>
                  <%= product.new_record? ? 'Publish Product' : 'Synchronize Data' %>
                </span>
                <div class="btn-blooom"></div>
              </button>
            </div>
            
            <div class="col-12 text-center mt-4">
              <%= link_to root_path, class: "back-link" do %>
                <i class="fa fa-arrow-left me-1"></i> Back to Dashboard
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

  :root {
    --celestial-primary: #6366f1;
    --celestial-secondary: #a855f7;
    --celestial-bg: #f8fafc;
    --card-bg: #ffffff;
    --text-slate: #1e293b;
    --border-soft: #e2e8f0;
  }

  .light-theme-wrapper {
    background-color: var(--celestial-bg);
    min-height: 100vh;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }

  .celestial-card {
    background: var(--card-bg);
    border: 1px solid var(--border-soft);
    border-radius: 2.5rem;
    max-width: 820px;
    width: 100%;
    position: relative;
    box-shadow: 0 40px 100px -20px rgba(0, 0, 0, 0.05);
  }

  /* Decorative Orbs */
  .mesh-gradient-1 {
    position: absolute;
    top: -20%;
    right: -10%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.08) 0%, transparent 70%);
    filter: blur(40px);
    z-index: 0;
  }

  .mesh-gradient-2 {
    position: absolute;
    bottom: -15%;
    left: -5%;
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.06) 0%, transparent 70%);
    filter: blur(40px);
    z-index: 0;
  }

  .brand-badge {
    width: 64px;
    height: 64px;
    background: #f1f5f9;
    border-radius: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
    margin: 0 auto;
    box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
  }

  .text-indigo-gradient {
    background: linear-gradient(135deg, var(--celestial-primary), var(--celestial-secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .fw-black { font-weight: 800; }
  .text-slate-800 { color: var(--text-slate); }
  .text-slate-500 { color: #64748b; }

  .horizontal-rule-gradient {
    width: 80px;
    height: 4px;
    background: linear-gradient(to right, var(--celestial-primary), var(--celestial-secondary));
    border-radius: 20px;
  }

  /* Form Elements */
  .floating-input-group {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .celestial-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: #475569;
    margin-left: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.025em;
  }

  .celestial-field-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .field-icon {
    position: absolute;
    left: 1.5rem;
    color: #94a3b8;
    font-size: 1.1rem;
    transition: all 0.3s ease;
  }

  .celestial-input, .celestial-select {
    width: 100%;
    background: #fdfdfd;
    border: 2px solid #f1f5f9;
    border-radius: 1.25rem;
    padding: 1.1rem 1.1rem 1.1rem 3.5rem;
    color: var(--text-slate);
    font-size: 1rem;
    font-weight: 500;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .celestial-select {
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
  }

  .celestial-input:focus, .celestial-select:focus {
    outline: none;
    background: white;
    border-color: var(--celestial-primary);
    box-shadow: 0 10px 25px -5px rgba(99, 102, 241, 0.1);
  }

  .celestial-input:focus + .field-icon,
  .celestial-select:focus + .field-icon {
    color: var(--celestial-primary);
    transform: scale(1.1);
  }

  .celestial-error {
    color: #ef4444;
    font-size: 0.75rem;
    font-weight: 600;
    margin-left: 1rem;
    display: flex;
    align-items: center;
  }
  
  .celestial-error::before {
    content: "!";
    background: #fee2e2;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-right: 6px;
  }

  /* Submit Button */
  .btn-celestial-submit {
    position: relative;
    width: 100%;
    padding: 1.35rem;
    background: linear-gradient(135deg, var(--celestial-primary), var(--celestial-secondary));
    border: none;
    border-radius: 1.25rem;
    color: white;
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 20px 40px -10px rgba(99, 102, 241, 0.4);
  }

  .btn-celestial-submit:hover {
    transform: translateY(-4px);
    box-shadow: 0 25px 50px -12px rgba(99, 102, 241, 0.6);
  }

  .btn-celestial-submit:active {
    transform: translateY(0);
    scale: 0.98;
  }

  .btn-blooom {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transition: none;
  }

  .btn-celestial-submit:hover .btn-blooom {
    animation: bloom 1.5s infinite;
  }

  @keyframes bloom {
    0% { left: -100%; }
    100% { left: 100%; }
  }

  .back-link {
    color: #94a3b8;
    font-size: 0.9rem;
    font-weight: 600;
    transition: color 0.2s;
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--celestial-primary);
  }

  /* Custom Select Arrow */
  .celestial-field-wrapper::after {
    content: "\f107";
    font-family: "Font Awesome 5 Free";
    font-weight: 900;
    position: absolute;
    right: 1.5rem;
    color: #cbd5e1;
    pointer-events: none;
    display: block;
  }

  /* Remove arrow for non-selects */
  .celestial-field-wrapper:has(input)::after {
    display: none;
  }
</style>
