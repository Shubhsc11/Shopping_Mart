<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h2 fw-bold text-dark mb-0">Our Products</h1>
  
  <div class="actions">
    <% if user_signed_in? %>
      <% if current_user.owner? %>
        <%= link_to new_product_path, class: "btn btn-success rounded-pill px-4 shadow-sm" do %>
          <i class="fa fa-plus me-2"></i> Create New Product
        <% end %>
      <% else %>
        <% item_count = current_user.cart&.cart_items&.count || 0 %>
        <%= link_to my_cart_path, class: "btn btn-outline-success rounded-pill px-4 shadow-sm position-relative" do %>
          <i class="fa fa-shopping-cart me-2 text-dark"></i> Cart
          <% if item_count > 0 %>
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
              <%= item_count %>
            </span>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>

<div class="row g-4">
  <% if user_signed_in? && current_user.owner? && current_user.products %>
    <% current_user.products.each do |product| %>
      <div class="col-12 col-md-6 col-lg-4">
        <div class="card product-card shadow-sm h-100">
          <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h5 class="card-title text-truncate" title="<%= product.p_name %>"><%= product.p_name %></h5>
              <span class="price-tag">$<%= product.p_price %></span>
            </div>
            
            <div class="mb-3">
              <% if product.category %>
                <span class="category-badge me-1"><%= product.category.category_name %></span>
              <% end %>
              <% if product.subcategory %>
                <small class="text-muted"><%= product.subcategory.subcategory_name %></small>
              <% end %>
            </div>

            <div class="mt-auto">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="badge bg-light text-dark border">Qty: <%= product.p_qty %></span>
              </div>
              <%= link_to product, class: "btn btn-outline-success w-100 rounded-pill" do %>
                <i class="fa fa-eye me-1"></i> View Details
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>

  <% else %>
    <% @products.each do |product| %>
      <div class="col-12 col-md-6 col-lg-4">
        <div class="card product-card shadow-sm h-100 border-0">
          <div class="card-body d-flex flex-column p-4">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h5 class="card-title h5 mb-0"><%= product.p_name %></h5>
              <span class="price-tag">$<%= product.p_price %></span>
            </div>

            <div class="mb-3">
              <% if product.category %>
                <%= link_to product.category.category_name, product.category, class: "category-badge" %>
              <% end %>
              <% if product.subcategory %>
                <span class="ms-1 text-muted small">• <%= product.subcategory.subcategory_name %></span>
              <% end %>
            </div>

            <p class="text-muted small mb-4">
              Availability: <span class="fw-bold <%= product.p_qty > 0 ? 'text-success' : 'text-danger' %>">
                <%= product.p_qty > 0 ? "#{product.p_qty} in stock" : "Out of stock" %>
              </span>
            </p>

            <div class="mt-auto">
              <% if user_signed_in? %>
                <div class="d-flex gap-2">
                  <%= button_to cart_items_path(product_id: product.id, action_key: 'buy'), method: :post, class: "btn btn-buy flex-grow-1" do %>
                    Buy Now
                  <% end %>
                  <%= button_to cart_items_path(product_id: product.id), method: :post, class: "btn btn-outline-primary rounded-pill px-3" do %>
                    <i class="fa fa-cart-plus"></i>
                  <% end %>
                </div>
              <% else %>
                <%= link_to new_user_session_path, class: "btn btn-buy w-100" do %>
                  Sign in to Buy
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
</div>

<% if @products.empty? && (!user_signed_in? || !current_user.owner? || !current_user.products&.any?) %>
  <div class="text-center py-5">
    <i class="fa fa-shopping-basket fa-4x text-muted mb-3"></i>
    <h3 class="text-muted">No products found</h3>
    <p>Check back later for more exciting items!</p>
  </div>
<% end %>
